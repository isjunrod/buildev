{
  "name": "buildev",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @buildev/web dev",
    "build": "pnpm --filter @buildev/web build",
    "start": "pnpm --filter @buildev/web start",
    "lint": "eslint apps/web packages --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "pnpm --filter @buildev/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
